generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL_UNPOOLED")
}

model Meeting {
  id              String    @id @default(cuid())
  // Source identifiers
  iqm2Id          Int?      @unique
  civicplusId     String?   @unique
  source          String    // "civicplus" | "iqm2"

  // Meeting details
  meetingTime     DateTime  // UTC stored, displayed in Pacific
  title           String?
  meetingType     String    // "City Council", "Planning Commission", etc.
  boardType       String?
  status          String    // "upcoming" | "final" | "cancelled" | "draft"
  location        String?
  zoomUrl         String?

  // Document links
  agendaUrl       String?
  agendaHtmlUrl   String?
  agendaPacketUrl String?
  minutesUrl      String?
  summaryUrl      String?
  meetingLink     String?

  // Metadata
  postedAt        DateTime?
  isAmended       Boolean   @default(false)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  // Relations
  agenda          Agenda?
  aiSummary       AISummary?
  translations    Translation[]
  notifications   NotificationLog[]

  @@index([meetingTime])
  @@index([meetingType])
  @@index([status])
}

model Agenda {
  id           String                  @id @default(cuid())
  meetingId    String                  @unique
  meeting      Meeting                 @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  agendaMd     String
  agendaHtml   String?
  searchVector Unsupported("tsvector")?
  createdAt    DateTime                @default(now())
  updatedAt    DateTime                @updatedAt

  @@index([meetingId])
}

model AISummary {
  id         String   @id @default(cuid())
  meetingId  String   @unique
  meeting    Meeting  @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  summary    String
  keyTopics  String[]
  model      String
  tokenCount Int?
  createdAt  DateTime @default(now())
}

model Translation {
  id        String   @id @default(cuid())
  meetingId String
  meeting   Meeting  @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  language  String   // "es" | "zh" | "vi" | "tl"
  field     String   // "summary" | "keyTopics"
  content   String
  createdAt DateTime @default(now())

  @@unique([meetingId, language, field])
}

// ─── User & Auth ─────────────────────────────────────────────

model User {
  id                String                  @id @default(cuid())
  email             String                  @unique
  emailVerified     DateTime?
  passwordHash      String?
  name              String?
  phone             String?
  phoneVerified     Boolean                 @default(false)
  preferredLanguage String                  @default("en")
  district          Int?
  role              String                  @default("user") // "user" | "admin"
  createdAt         DateTime                @default(now())
  updatedAt         DateTime                @updatedAt

  accounts          Account[]
  sessions          Session[]
  preferences       NotificationPreference?
  notificationLogs  NotificationLog[]
}

model NotificationPreference {
  id                   String   @id @default(cuid())
  userId               String   @unique
  user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  emailEnabled         Boolean  @default(true)
  smsEnabled           Boolean  @default(false)
  notifyOnNewMeeting   Boolean  @default(true)
  notifyOnAgendaPosted Boolean  @default(true)
  notifyOnMinutes      Boolean  @default(false)
  meetingTypes         String[]
  daysBefore           Int      @default(3)
  updatedAt            DateTime @updatedAt
}

model NotificationLog {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  meetingId String
  meeting   Meeting  @relation(fields: [meetingId], references: [id])
  channel   String   // "email" | "sms"
  type      String   // "reminder" | "agenda_posted" | "minutes_posted"
  status    String   // "sent" | "failed"
  error     String?
  sentAt    DateTime @default(now())
}

// NextAuth v5 required models

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}
